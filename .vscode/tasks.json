{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile extension",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "--prefix",
        "frontend/extension",
        "run",
        "compile"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "start backend uvicorn",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev:backend:conda"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "prepare extension debug",
      "dependsOn": ["compile extension", "start backend uvicorn"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
